PORT=4000
# Pon TRUST_PROXY=true solo si corres detrás de un proxy inverso (Render, Railway, nginx).
TRUST_PROXY=false

# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

DB_PATH=./data/campana.db

# Orígenes externos autorizados a leer /api/estado y /api/banners (separados por coma, sin comodines).
CORS_ORIGINS=

# Hostnames exactos permitidos para imágenes y enlaces de los banners.
ALLOWED_ASSET_HOSTS=cdn.tupartido.ec
ALLOWED_LINK_HOSTS=tupartido.ec,www.tupartido.ec

# Mux: Settings > Access Tokens (permiso Mux Video: Read + Write) y Settings > Webhooks.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# Silencio electoral (ISO 8601 con zona horaria de Ecuador, -05:00). Ajusta según el calendario del CNE.
SILENCIO_ELECTORAL_INICIO=
SILENCIO_ELECTORAL_FIN=
